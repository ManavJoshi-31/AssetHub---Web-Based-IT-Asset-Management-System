@model AssetHub.ViewModels.LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<div class="login-split-layout">
    <!-- Left Column: Open Brand & Platform Capabilities -->
    <div class="login-showcase-side">
        <div class="login-kicker">
            <i class="bi bi-shield-lock-fill"></i>
            <span>Enterprise Asset Portal</span>
        </div>

        <h1 class="login-heading">
            Secure Custody &amp; Fleet Management
        </h1>

        <p class="login-desc">
            Sign in to access your organization's IT workspace. Verify equipment custody, monitor lifecycle states, and track warranty renewals with role-based security.
        </p>

        <!-- Live Platform Metrics Tiles -->
        <div class="showcase-stat-row">
            <div class="stat-box">
                <div class="stat-num">100%</div>
                <div class="stat-lbl">Fleet Visibility</div>
            </div>
            <div class="stat-box">
                <div class="stat-num">Zero</div>
                <div class="stat-lbl">Allocation Conflict</div>
            </div>
            <div class="stat-box">
                <div class="stat-num">SOC-2</div>
                <div class="stat-lbl">Audit Ready</div>
            </div>
        </div>

        <!-- Capability Bullet Points -->
        <div class="showcase-benefit-list">
            <div class="benefit-item">
                <i class="bi bi-check-circle-fill"></i>
                <span>Complete asset lifecycle: Register &rarr; Assign &rarr; Return &rarr; Maintain</span>
            </div>
            <div class="benefit-item">
                <i class="bi bi-check-circle-fill"></i>
                <span>Multi-department equipment custody logs and ownership tracking</span>
            </div>
            <div class="benefit-item">
                <i class="bi bi-check-circle-fill"></i>
                <span>Automated servicing alerts and preventative maintenance schedules</span>
            </div>
        </div>
    </div>

    <!-- Right Column: Crisp, Modern Login Form -->
    <div class="login-card-container">
        <div class="card-title-header">
            <h2 class="card-main-title">Sign in to AssetHub</h2>
            <p class="card-subtitle">Enter your corporate credentials to continue</p>
        </div>

        <form asp-action="Login" method="post" id="loginForm" novalidate>
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <!-- Server-Side Validation Errors Banner -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div asp-validation-summary="ModelOnly" class="auth-alert-danger"></div>
            }

            <!-- Work Email -->
            <div class="form-field-group">
                <label asp-for="Email" class="field-label">
                    <span>Work Email Address</span>
                </label>
                <div class="input-with-icon">
                    <i class="bi bi-envelope input-leading-icon"></i>
                    <input asp-for="Email" 
                           class="modern-input" 
                           id="emailInput" 
                           placeholder="user@company.com" 
                           type="email"
                           required 
                           autocomplete="username" />
                </div>
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>

            <!-- Password -->
            <div class="form-field-group">
                <div class="field-label">
                    <label asp-for="Password" class="mb-0">Password</label>
                    <a href="javascript:void(0)" class="link-forgot" title="Contact your IT Administrator to reset credentials">
                        Forgot password?
                    </a>
                </div>
                <div class="input-with-icon">
                    <i class="bi bi-lock input-leading-icon"></i>
                    <input asp-for="Password" 
                           class="modern-input" 
                           id="passwordInput" 
                           placeholder="••••••••••••" 
                           type="password"
                           required 
                           autocomplete="current-password" />
                    <button type="button" class="btn-toggle-eye" id="togglePassword" aria-label="Toggle password visibility">
                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>

            <!-- Remember Me -->
            <div class="remember-row">
                <label class="custom-checkbox-wrap">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span class="check-square"></span>
                    <span class="check-label">Remember this workstation</span>
                </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-login-submit" id="submitBtn">
                <span>Sign in to Workspace</span>
                <i class="bi bi-arrow-right ms-2"></i>
            </button>

            <!-- Quick Demo Testing Credentials -->
            <div class="demo-quick-box">
                <span class="demo-title-text">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Test:
                </span>
                <div class="demo-pills">
                    <button type="button" class="btn-demo-tag" id="fillAdminDemo">
                        <i class="bi bi-shield-lock me-1"></i> Admin
                    </button>
                    <button type="button" class="btn-demo-tag" id="fillManagerDemo">
                        <i class="bi bi-person me-1"></i> Manager
                    </button>
                </div>
            </div>

            <!-- Register / Switch to Register Link -->
            <div class="card-signup-footer">
                <span>Don't have an account yet?</span>
                <a asp-action="Register" class="link-register">Register here</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}