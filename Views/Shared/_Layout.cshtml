@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AssetHub</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AssetHub.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        @if (isAuthenticated)
        {
            <!-- =========================
                 SIDEBAR
                 ========================= -->
            <aside class="app-sidebar">

                <a class="app-brand"
                   asp-controller="Home"
                   asp-action="Dashboard">
                    <i class="bi bi-box-seam-fill me-2" style="color: #3b82f6;"></i>
                    <span>AssetHub</span>
                </a>

                <div class="app-sidebar-content">

                    <!-- Main -->
                    <div class="sidebar-section">
                        <div class="sidebar-section-title">
                            Main
                        </div>

                        <a class="sidebar-link @(currentController == "Home" && (currentAction == "Dashboard" || currentAction == "Index") ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Dashboard">
                            <span class="sidebar-icon">⌂</span>
                            <span>Dashboard</span>
                        </a>
                    </div>


                    <!-- Asset Management -->
                    <div class="sidebar-section">
                        <div class="sidebar-section-title">
                            Asset Management
                        </div>

                        <a class="sidebar-link @(currentController == "Asset" ? "active" : "")"
                           asp-controller="Asset"
                           asp-action="Index">
                            <span class="sidebar-icon">▣</span>
                            <span>Assets</span>
                        </a>

                        <a class="sidebar-link @(currentController == "AssetCategory" ? "active" : "")"
                           asp-controller="AssetCategory"
                           asp-action="Index">
                            <span class="sidebar-icon">◫</span>
                            <span>Categories</span>
                        </a>
                    </div>


                    <!-- People -->
                    <div class="sidebar-section">
                        <div class="sidebar-section-title">
                            People
                        </div>

                        <a class="sidebar-link @(currentController == "Employee" ? "active" : "")"
                           asp-controller="Employee"
                           asp-action="Index">
                            <span class="sidebar-icon">♙</span>
                            <span>Employees</span>
                        </a>

                        <a class="sidebar-link @(currentController == "Department" ? "active" : "")"
                           asp-controller="Department"
                           asp-action="Index">
                            <span class="sidebar-icon">▤</span>
                            <span>Departments</span>
                        </a>
                    </div>


                    <!-- Operations -->
                    <div class="sidebar-section">
                        <div class="sidebar-section-title">
                            Operations
                        </div>

                        <a class="sidebar-link @(currentController == "AssetAssignment" ? "active" : "")"
                           asp-controller="AssetAssignment"
                           asp-action="Create">
                            <span class="sidebar-icon">↗</span>
                            <span>Assignment</span>
                        </a>

                        <a class="sidebar-link @(currentController == "AssetReturn" ? "active" : "")"
                           asp-controller="AssetReturn"
                           asp-action="Create">
                            <span class="sidebar-icon">↙</span>
                            <span>Return</span>
                        </a>

                        <a class="sidebar-link @(currentController == "Maintenance" ? "active" : "")"
                           asp-controller="Maintenance"
                           asp-action="Index">
                            <span class="sidebar-icon">⚙</span>
                            <span>Maintenance</span>
                        </a>

                        <a class="sidebar-link @(currentController == "Warranty" ? "active" : "")"
                           asp-controller="Warranty"
                           asp-action="Index">
                            <span class="sidebar-icon">✓</span>
                            <span>Warranty</span>
                        </a>
                    </div>

                </div>

            </aside>
        }


        <!-- =========================
             MAIN APPLICATION AREA
             ========================= -->

        <div class="app-main @(isAuthenticated ? "" : "app-main-full")">

            @if (isAuthenticated)
            {
                <!-- =========================
                     TOP BAR
                     ========================= -->

                <header class="app-topbar">

                    <div>
                        <span class="fw-semibold text-secondary">
                            @ViewData["Title"]
                        </span>
                    </div>


                    <div class="app-user">

                        @{
                            var userName = User.Identity?.Name;
                            var userInitial =
                                !string.IsNullOrWhiteSpace(userName)
                                    ? userName.Substring(0, 1).ToUpper()
                                    : "U";
                        }

                        <div class="app-user-avatar">
                            @userInitial
                        </div>


                        <div>

                            <div class="fw-semibold">
                                @(userName ?? "User")
                            </div>

                            <div class="small text-muted">
                                AssetHub User
                            </div>

                        </div>


                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="ms-3">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-secondary btn-sm">

                                Logout

                            </button>

                        </form>

                    </div>

                </header>
            }


            <!-- =========================
                 PAGE CONTENT
                 ========================= -->

            <main role="main"
                  class="app-content">

                @RenderBody()

            </main>


            <!-- =========================
                 FOOTER
                 ========================= -->

            <footer class="app-footer">

                <div>
                    &copy; @DateTime.UtcNow.Year AssetHub
                </div>

            </footer>

        </div>

    </div>


    <!-- =========================
         JAVASCRIPT
         ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>