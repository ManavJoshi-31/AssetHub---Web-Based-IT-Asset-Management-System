@model IEnumerable<AssetHub.ViewModels.EmployeeListViewModel>

@{
    ViewData["Title"] = "Employees";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Employees</h1>
        <p class="text-muted mb-0">
            Manage organization employees, team assignments, and equipment custodians.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i>
        <span>Add Employee</span>
    </a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <div class="metric-icon-box icon-box-primary mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.75rem;">
                <i class="bi bi-people"></i>
            </div>
            <h5 class="fw-bold mb-1">No employees found</h5>
            <p class="text-muted mb-4">No employee records have been created in the system yet.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus-fill me-1"></i>
                <span>Add Your First Employee</span>
            </a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body border-bottom py-3 px-4">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Employee Directory</h5>
                <span class="badge bg-primary-subtle text-primary">@Model.Count() Employees</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Employee Code</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Job Title</th>
                        <th>Joining Date</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var employee in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-primary">
                                @employee.EmployeeCode
                            </td>

                            <td class="fw-bold text-dark">
                                @employee.FirstName @employee.LastName
                            </td>

                            <td class="text-muted">
                                @employee.Email
                            </td>

                            <td>
                                <span class="badge bg-secondary-subtle">
                                    @employee.DepartmentName
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(employee.JobTitle)
                                    ? "-"
                                    : employee.JobTitle)
                            </td>

                            <td>
                                @employee.DateOfJoining.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (employee.IsActive)
                                {
                                    <span class="badge bg-success-subtle">
                                        <span class="status-dot" style="width: 6px; height: 6px;"></span>
                                        @employee.EmploymentStatus
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle">
                                        @employee.EmploymentStatus
                                    </span>
                                }
                            </td>

                            <td class="text-end pe-4">
                                <a asp-action="Edit"
                                   asp-route-id="@employee.EmployeeId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square me-1"></i>
                                    <span>Edit</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}