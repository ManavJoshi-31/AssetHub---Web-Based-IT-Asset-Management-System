@{
    ViewData["Title"] = "Dashboard";
}

<!-- Dashboard Header -->
<div class="mb-4">
    <h1 class="fw-bold mb-1">Dashboard</h1>

    <p class="text-muted mb-0">
        Welcome to AssetHub. Manage and monitor your organization's assets.
    </p>
</div>


<!-- Quick Stats -->
<div class="row g-4 mb-4">

    <!-- Assets -->
    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <div class="text-muted small mb-2">
                            Asset Management
                        </div>

                        <h5 class="fw-semibold mb-2">
                            Assets
                        </h5>

                        <p class="text-muted small mb-0">
                            View and manage your IT assets.
                        </p>
                    </div>

                    <div class="rounded-3 bg-primary-subtle text-primary
                        d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">

                        <span class="fs-5">
                            ▣
                        </span>

                    </div>

                </div>

                <div class="mt-4">

                    <a asp-controller="Asset"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary">
                        View Assets
                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Employees -->
    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <div class="text-muted small mb-2">
                            People
                        </div>

                        <h5 class="fw-semibold mb-2">
                            Employees
                        </h5>

                        <p class="text-muted small mb-0">
                            Manage employees and asset users.
                        </p>
                    </div>

                    <div class="rounded-3 bg-success-subtle text-success
                        d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">

                        <span class="fs-5">
                            ♙
                        </span>

                    </div>

                </div>

                <div class="mt-4">

                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-success">
                        View Employees
                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Assignment -->
    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <div class="text-muted small mb-2">
                            Operations
                        </div>

                        <h5 class="fw-semibold mb-2">
                            Assignment
                        </h5>

                        <p class="text-muted small mb-0">
                            Assign available assets to employees.
                        </p>
                    </div>

                    <div class="rounded-3 bg-warning-subtle text-warning-emphasis
                        d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">

                        <span class="fs-5">
                            ↗
                        </span>

                    </div>

                </div>

                <div class="mt-4">

                    <a asp-controller="AssetAssignment"
                       asp-action="Create"
                       class="btn btn-sm btn-outline-warning">
                        Assign Asset
                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Maintenance -->
    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <div class="text-muted small mb-2">
                            Operations
                        </div>

                        <h5 class="fw-semibold mb-2">
                            Maintenance
                        </h5>

                        <p class="text-muted small mb-0">
                            Track asset maintenance activities.
                        </p>
                    </div>

                    <div class="rounded-3 bg-danger-subtle text-danger
                        d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">

                        <span class="fs-5">
                            ⚙
                        </span>

                    </div>

                </div>

                <div class="mt-4">

                    <a asp-controller="Maintenance"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-danger">
                        View Maintenance
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Quick Actions -->
<div class="row g-4">

    <!-- Quick Actions -->
    <div class="col-lg-8">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <h5 class="fw-semibold mb-1">
                    Quick Actions
                </h5>

                <p class="text-muted small mb-4">
                    Common tasks you may want to perform.
                </p>


                <div class="row g-3">

                    <div class="col-md-6">

                        <a asp-controller="Asset"
                           asp-action="Create"
                           class="text-decoration-none">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="fw-semibold text-dark">
                                    + Add Asset
                                </div>

                                <small class="text-muted">
                                    Register a new IT asset.
                                </small>

                            </div>

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a asp-controller="AssetAssignment"
                           asp-action="Create"
                           class="text-decoration-none">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="fw-semibold text-dark">
                                    Assign Asset
                                </div>

                                <small class="text-muted">
                                    Assign an available asset.
                                </small>

                            </div>

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a asp-controller="AssetReturn"
                           asp-action="Create"
                           class="text-decoration-none">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="fw-semibold text-dark">
                                    Return Asset
                                </div>

                                <small class="text-muted">
                                    Process an asset return.
                                </small>

                            </div>

                        </a>

                    </div>


                    <div class="col-md-6">

                        <a asp-controller="Maintenance"
                           asp-action="Create"
                           class="text-decoration-none">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="fw-semibold text-dark">
                                    Create Maintenance
                                </div>

                                <small class="text-muted">
                                    Record maintenance work.
                                </small>

                            </div>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- System Navigation -->
    <div class="col-lg-4">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <h5 class="fw-semibold mb-1">
                    Management
                </h5>

                <p class="text-muted small mb-4">
                    Access the main management areas.
                </p>


                <div class="d-grid gap-2">

                    <a asp-controller="Department"
                       asp-action="Index"
                       class="btn btn-outline-secondary text-start">
                        Departments
                    </a>

                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="btn btn-outline-secondary text-start">
                        Employees
                    </a>

                    <a asp-controller="AssetCategory"
                       asp-action="Index"
                       class="btn btn-outline-secondary text-start">
                        Asset Categories
                    </a>

                    <a asp-controller="Warranty"
                       asp-action="Index"
                       class="btn btn-outline-secondary text-start">
                        Warranties
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>