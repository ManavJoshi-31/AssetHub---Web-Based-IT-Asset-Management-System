@using Microsoft.AspNetCore.Identity
@inject SignInManager<AssetHub.Models.ApplicationUser> SignInManager

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Welcome to AssetHub";
}

<div class="welcome-hero-container">
    <!-- Welcome to AssetHub Pill Button -->
    <button type="button" class="hero-pill-badge" id="welcomeBtn" aria-label="Welcome to AssetHub">
        <i class="bi bi-stars"></i>
        <span>Welcome to AssetHub</span>
    </button>

    <!-- Main Hero Headings -->
    <h1 class="hero-headline">
        Complete IT Asset Lifecycle &amp; <span class="gradient-span">Fleet Intelligence</span>
    </h1>

    <p class="hero-subheadline">
        Centralize your organizational hardware, eliminate duplicate equipment allocations, monitor employee custody chains, and audit warranties in one unified enterprise platform.
    </p>

    <!-- Call to Action Buttons -->
    <div class="hero-actions-row">
        @if (SignInManager.IsSignedIn(User))
        {
            <a asp-controller="Home" asp-action="Dashboard" class="btn-hero-primary" id="getStartedBtn">
                <span>Go to Asset Dashboard</span>
                <i class="bi bi-arrow-right ms-1"></i>
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn-hero-primary" id="getStartedBtn">
                <span>Get Started</span>
                <i class="bi bi-arrow-right ms-1"></i>
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn-hero-secondary">
                <i class="bi bi-shield-lock me-1"></i>
                <span>Sign In to Portal</span>
            </a>
        }
    </div>

    <!-- 3-Column Open Feature Capabilities Grid -->
    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon-wrapper">
                <i class="bi bi-laptop"></i>
            </div>
            <h3 class="feature-card-title">Fleet &amp; Equipment Oversight</h3>
            <p class="feature-card-desc">
                Comprehensive tracking for laptops, workstations, monitors, and networking devices mapped by department and category.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon-wrapper">
                <i class="bi bi-shield-check"></i>
            </div>
            <h3 class="feature-card-title">Verified Custody Chains</h3>
            <p class="feature-card-desc">
                Real-time assignment and return workflows that eliminate duplicate allocations and maintain transparent ownership records.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon-wrapper">
                <i class="bi bi-wrench-adjustable"></i>
            </div>
            <h3 class="feature-card-title">Maintenance &amp; Warranty Audits</h3>
            <p class="feature-card-desc">
                Proactive warranty expiration alerts, vendor service logs, and automated lifecycle state tracking from registration to retirement.
            </p>
        </div>
    </div>
</div>
