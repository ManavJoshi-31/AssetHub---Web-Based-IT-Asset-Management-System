@model IEnumerable<AssetHub.ViewModels.AssetListViewModel>

@{
    ViewData["Title"] = "Assets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Assets</h1>
        <p class="text-muted mb-0">View and manage IT assets.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Asset
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No assets have been registered yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Asset Tag</th>
                    <th>Asset Name</th>
                    <th>Category</th>
                    <th>Brand / Model</th>
                    <th>Serial Number</th>
                    <th>Status</th>
                    <th>Condition</th>
                    <th>Location</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var asset in Model)
                {
                    <tr>
                        <td>
                            <strong>@asset.AssetTag</strong>
                        </td>

                        <td>@asset.AssetName</td>

                        <td>@asset.CategoryName</td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(asset.Brand) ||
                                 !string.IsNullOrWhiteSpace(asset.Model))
                            {
                                @($"{asset.Brand} {asset.Model}".Trim())
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(asset.SerialNumber))
                            {
                                @asset.SerialNumber
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td>
                            <span class="badge bg-secondary">
                                @asset.AssetStatus
                            </span>
                        </td>

                        <td>@asset.Condition</td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(asset.Location))
                            {
                                @asset.Location
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td>
                            @if (asset.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>

                        <td>
    <div class="d-flex gap-1">
        <a asp-action="Edit"
           asp-route-id="@asset.AssetId"
           class="btn btn-sm btn-outline-primary">
            Edit
        </a>

        <a asp-action="ChangeStatus"
           asp-route-id="@asset.AssetId"
           class="btn btn-sm btn-outline-secondary">
            Status
        </a>
    </div>
</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}