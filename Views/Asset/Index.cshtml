@model IEnumerable<AssetHub.ViewModels.AssetListViewModel>

@{
    ViewData["Title"] = "Assets";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Assets</h1>
        <p class="text-muted mb-0">
            View and manage IT assets.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + Add Asset
    </a>
</div>


<!-- Search & Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">

        <div class="d-flex align-items-center mb-3">
            <div>
                <h5 class="mb-1 fw-semibold">
                    Search & Filter
                </h5>

                <small class="text-muted">
                    Find assets by tag, name, category, status or condition.
                </small>
            </div>
        </div>


        <form asp-action="Index"
              method="get">

            <div class="row g-3">

                <!-- Search -->
                <div class="col-lg-4 col-md-6">

                    <label for="Search"
                           class="form-label fw-semibold">
                        Search
                    </label>

                    <input type="text"
                           id="Search"
                           name="Search"
                           value="@ViewBag.Filter?.Search"
                           class="form-control"
                           placeholder="Asset tag, name, serial, brand..." />

                </div>


                <!-- Category -->
                <div class="col-lg-2 col-md-6">

                    <label for="AssetCategoryId"
                           class="form-label fw-semibold">
                        Category
                    </label>

                    <select id="AssetCategoryId"
                            name="AssetCategoryId"
                            class="form-select">

                        <option value="">
                            All Categories
                        </option>

                        @foreach (var category in ViewBag.FilterCategories)
                        {
                            <option value="@category.AssetCategoryId"
                                    selected="@(ViewBag.Filter?.AssetCategoryId == category.AssetCategoryId ? "selected" : null)">
                                @category.CategoryName
                            </option>
                        }

                    </select>

                </div>


                <!-- Status -->
                <div class="col-lg-2 col-md-6">

                    <label for="AssetStatus"
                           class="form-label fw-semibold">
                        Status
                    </label>

                    <select id="AssetStatus"
                            name="AssetStatus"
                            class="form-select">

                        <option value="">
                            All Statuses
                        </option>

                        @foreach (var status in Enum.GetValues<AssetHub.Models.Enums.AssetStatus>())
                        {
                            <option value="@status"
                                    selected="@(ViewBag.Filter?.AssetStatus == status ? "selected" : null)">
                                @status
                            </option>
                        }

                    </select>

                </div>


                <!-- Condition -->
                <div class="col-lg-2 col-md-6">

                    <label for="Condition"
                           class="form-label fw-semibold">
                        Condition
                    </label>

                    <select id="Condition"
                            name="Condition"
                            class="form-select">

                        <option value="">
                            All Conditions
                        </option>

                        @foreach (var condition in Enum.GetValues<AssetHub.Models.Enums.AssetCondition>())
                        {
                            <option value="@condition"
                                    selected="@(ViewBag.Filter?.Condition == condition ? "selected" : null)">
                                @condition
                            </option>
                        }

                    </select>

                </div>


                <!-- Filter button -->
                <div class="col-lg-2 col-md-12 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Filter
                    </button>

                </div>

            </div>


            <!-- Clear -->
            <div class="mt-3">

                <a asp-action="Index"
                   class="btn btn-sm btn-outline-secondary">
                    Clear Filters
                </a>

            </div>

        </form>

    </div>
</div>


<!-- Assets -->
@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">

        <div class="card-body text-center py-5">

            <div class="fs-1 mb-3">
                📦
            </div>

            <h5 class="fw-semibold">
                No assets found
            </h5>

            <p class="text-muted mb-4">
                No assets match your current search or filters.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                + Add Your First Asset
            </a>

        </div>

    </div>
}
else
{
    <div class="card border-0 shadow-sm">

        <!-- Table Header -->
        <div class="card-body border-bottom">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-semibold mb-1">
                        Asset Inventory
                    </h5>

                    <small class="text-muted">
                        Showing @Model.Count() asset(s)
                    </small>
                </div>

            </div>

        </div>


        <!-- Table -->
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="ps-4">
                            Asset
                        </th>

                        <th>
                            Category
                        </th>

                        <th>
                            Brand / Model
                        </th>

                        <th>
                            Serial Number
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Condition
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Active
                        </th>

                        <th class="text-end pe-4">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var asset in Model)
                    {
                        <tr>

                            <!-- Asset -->
                            <td class="ps-4">

                                <div class="fw-semibold">
                                    @asset.AssetTag
                                </div>

                                <small class="text-muted">
                                    @asset.AssetName
                                </small>

                            </td>


                            <!-- Category -->
                            <td>

                                <span class="text-muted">
                                    @asset.CategoryName
                                </span>

                            </td>


                            <!-- Brand / Model -->
                            <td>

                                @if (!string.IsNullOrWhiteSpace(asset.Brand) ||
                                    !string.IsNullOrWhiteSpace(asset.Model))
                                {
                                    <span>
                                        @($"{asset.Brand} {asset.Model}".Trim())
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <!-- Serial -->
                            <td>

                                @if (!string.IsNullOrWhiteSpace(asset.SerialNumber))
                                {
                                    <code>
                                        @asset.SerialNumber
                                    </code>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <!-- Status -->
                            <td>

                                @switch (asset.AssetStatus)
                                {
                                    case AssetHub.Models.Enums.AssetStatus.Available:

                                        <span class="badge bg-success-subtle text-success">
                                            Available
                                        </span>

                                        break;

                                    case AssetHub.Models.Enums.AssetStatus.Assigned:

                                        <span class="badge bg-primary-subtle text-primary">
                                            Assigned
                                        </span>

                                        break;

                                    case AssetHub.Models.Enums.AssetStatus.Maintenance:

                                        <span class="badge bg-warning-subtle text-warning-emphasis">
                                            Maintenance
                                        </span>

                                        break;

                                    case AssetHub.Models.Enums.AssetStatus.Retired:

                                        <span class="badge bg-secondary-subtle text-secondary">
                                            Retired
                                        </span>

                                        break;

                                    case AssetHub.Models.Enums.AssetStatus.Lost:

                                        <span class="badge bg-danger-subtle text-danger">
                                            Lost
                                        </span>

                                        break;

                                    default:

                                        <span class="badge bg-secondary-subtle text-secondary">
                                            @asset.AssetStatus
                                        </span>

                                        break;
                                }

                            </td>


                            <!-- Condition -->
                            <td>

                                @switch (asset.Condition)
                                {
                                    case AssetHub.Models.Enums.AssetCondition.New:

                                        <span class="badge bg-success-subtle text-success">
                                            New
                                        </span>

                                        break;

                                    case AssetHub.Models.Enums.AssetCondition.Good:

                                        <span class="badge bg-primary-subtle text-primary">
                                            Good
                                        </span>

                                        break;

                                    case AssetHub.Models.Enums.AssetCondition.Fair:

                                        <span class="badge bg-warning-subtle text-warning-emphasis">
                                            Fair
                                        </span>

                                        break;

                                    case AssetHub.Models.Enums.AssetCondition.Damaged:

                                        <span class="badge bg-danger-subtle text-danger">
                                            Damaged
                                        </span>

                                        break;

                                    default:

                                        <span class="badge bg-secondary-subtle text-secondary">
                                            @asset.Condition
                                        </span>

                                        break;
                                }

                            </td>


                            <!-- Location -->
                            <td>

                                @if (!string.IsNullOrWhiteSpace(asset.Location))
                                {
                                    @asset.Location
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <!-- Active -->
                            <td>

                                @if (asset.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <!-- Actions -->
                            <td class="pe-4">

                                <div class="d-flex justify-content-end gap-1">

                                    <a asp-action="Edit"
                                       asp-route-id="@asset.AssetId"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>


                                    <a asp-action="ChangeStatus"
                                       asp-route-id="@asset.AssetId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Status
                                    </a>


                                    <a asp-controller="AssetStatusHistory"
                                       asp-action="Index"
                                       asp-route-assetId="@asset.AssetId"
                                       class="btn btn-sm btn-outline-secondary">
                                        History
                                    </a>


                                    <form asp-action="ToggleActive"
                                          asp-route-id="@asset.AssetId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        @if (asset.IsActive)
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning">
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Activate
                                            </button>
                                        }

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}