@model IEnumerable<AssetHub.ViewModels.AssetListViewModel>

@{
    ViewData["Title"] = "Assets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Assets</h1>
        <p class="text-muted mb-0">View and manage IT assets.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Asset
    </a>
</div>
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">

            <div class="row g-3">

                <div class="col-md-4">
                    <label for="Search" class="form-label">
                        Search
                    </label>

                    <input type="text"
                           id="Search"
                           name="Search"
                           value="@ViewBag.Filter?.Search"
                           class="form-control"
                           placeholder="Asset tag, name, serial, brand..." />
                </div>

                <div class="col-md-3">
                    <label for="AssetCategoryId" class="form-label">
                        Category
                    </label>

                    <select id="AssetCategoryId"
                            name="AssetCategoryId"
                            class="form-select">

                        <option value="">All Categories</option>

                        @foreach (var category in ViewBag.FilterCategories)
                        {
                            <option value="@category.AssetCategoryId"
                                    selected="@(ViewBag.Filter?.AssetCategoryId == category.AssetCategoryId ? "selected" : null)">
                                @category.CategoryName
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="AssetStatus" class="form-label">
                        Status
                    </label>

                    <select id="AssetStatus"
                            name="AssetStatus"
                            class="form-select">

                        <option value="">All Statuses</option>

                        @foreach (var status in Enum.GetValues<AssetHub.Models.Enums.AssetStatus>())
                        {
                            <option value="@status"
                                    selected="@(ViewBag.Filter?.AssetStatus == status ? "selected" : null)">
                                @status
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="Condition" class="form-label">
                        Condition
                    </label>

                    <select id="Condition"
                            name="Condition"
                            class="form-select">

                        <option value="">All Conditions</option>

                        @foreach (var condition in Enum.GetValues<AssetHub.Models.Enums.AssetCondition>())
                        {
                            <option value="@condition"
                                    selected="@(ViewBag.Filter?.Condition == condition ? "selected" : null)">
                                @condition
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Filter
                    </button>
                </div>

            </div>

            <div class="mt-3">
                <a asp-action="Index"
                   class="btn btn-outline-secondary btn-sm">
                    Clear Filters
                </a>
            </div>

        </form>
    </div>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">
        No assets have been registered yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Asset Tag</th>
                    <th>Asset Name</th>
                    <th>Category</th>
                    <th>Brand / Model</th>
                    <th>Serial Number</th>
                    <th>Status</th>
                    <th>Condition</th>
                    <th>Location</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var asset in Model)
                {
                    <tr>
                        <td>
                            <strong>@asset.AssetTag</strong>
                        </td>

                        <td>@asset.AssetName</td>

                        <td>@asset.CategoryName</td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(asset.Brand) ||
                                 !string.IsNullOrWhiteSpace(asset.Model))
                            {
                                @($"{asset.Brand} {asset.Model}".Trim())
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(asset.SerialNumber))
                            {
                                @asset.SerialNumber
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td>
                            <span class="badge bg-secondary">
                                @asset.AssetStatus
                            </span>
                        </td>

                        <td>@asset.Condition</td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(asset.Location))
                            {
                                @asset.Location
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td>
                            @if (asset.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit"
                                   asp-route-id="@asset.AssetId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-action="ChangeStatus"
                                   asp-route-id="@asset.AssetId"
                                   class="btn btn-sm btn-outline-secondary">
                                    Status
                                </a>

                                <form asp-action="ToggleActive"
                                      asp-route-id="@asset.AssetId"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    @if (asset.IsActive)
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-warning">
                                            Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Activate
                                        </button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}