@model AssetHub.ViewModels.AssetStatusViewModel

@{
    ViewData["Title"] = "Change Asset Status";
}

<div class="mb-4">
    <h1 class="mb-1">Change Asset Status</h1>
    <p class="text-muted mb-0">Update the lifecycle status of this asset.</p>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">Asset Status</h5>
    </div>

    <div class="card-body">
        <dl class="row mb-4">
            <dt class="col-sm-3">Asset Tag</dt>
            <dd class="col-sm-9">@Model.AssetTag</dd>

            <dt class="col-sm-3">Asset Name</dt>
            <dd class="col-sm-9">@Model.AssetName</dd>

            <dt class="col-sm-3">Current Status</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">
                    @Model.CurrentStatus
                </span>
            </dd>
        </dl>

        <form asp-action="ChangeStatus" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="AssetId" />
            <input type="hidden" asp-for="AssetTag" />
            <input type="hidden" asp-for="AssetName" />
            <input type="hidden" asp-for="CurrentStatus" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="NewStatus" class="form-label"></label>

                <select asp-for="NewStatus"
        class="form-select"
        asp-items="@(new SelectList(
            ViewBag.AllowedStatuses,
            "Value",
            "Text"))">
    <option value="">-- Select New Status --</option>
</select>

                <span asp-validation-for="NewStatus" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Change Status
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}